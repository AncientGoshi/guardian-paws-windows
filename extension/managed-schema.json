{
  "type": "object",
  "properties": {
    "policy": {
      "type": "object",
      "properties": {
        "siteLimits": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "host": { "type": "string" },
              "minutes": { "type": "integer", "minimum": 1, "maximum": 1440 }
            },
            "required": ["host", "minutes"]
          }
        },
        "alwaysAllowedSites": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
